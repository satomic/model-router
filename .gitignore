# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# All persistent state lives under data/, and all of it is either a credential or private:
#   data/config.yaml          provider api_key, the OAuth client_secret, the GitHub
#                             Enterprise admin token, the local admin's password hash
#   data/auth_sessions.json   live sign-in sessions
#   data/api_keys.json        issued API keys
#   data/github/              the cached GitHub structure and member lists
#   data/logs/traces/         full-chain trace records, i.e. real prompts and replies
# One ignored directory covers all of it. config.example.yaml is the committed template and
# carries placeholders only.
data/

# The bare filename too, belt and braces: this is the one file whose accidental commit would
# publish every credential, and it sat at the repository root in earlier versions.
config.yaml

#   .env         local environment overrides
.env
.env.*
!.env.example

# Logs -- uvicorn output at the root; the traces themselves are covered by data/ above.
logs/
*.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/

# Scratch space. Working notes live here and have held real credentials, so the whole
# directory is excluded rather than filtered file by file.
tmp/
*.tmp
*.bak
*.orig

# Tool output. Screenshots are scoped to this directory rather than ignored by extension,
# so a deliberate docs image can still be committed.
.playwright-mcp/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

perf/